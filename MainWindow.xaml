<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="LocalAiMemoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:LocalAiMemoApp">
    <Grid Padding="20" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左の列：準備・絞り込み・メモ一覧 -->
        <Grid Grid.Column="0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Uid="AppTitleText" Style="{ThemeResource TitleTextBlockStyle}"/>
            <StackPanel Grid.Row="1" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="NewButton" x:Uid="NewButton" Click="New_Click"
                            AutomationProperties.AutomationId="NewButton"/>
                    <Button x:Name="PrepareButton" x:Uid="PrepareButton" Click="Prepare_Click"
                            Style="{ThemeResource AccentButtonStyle}"
                            AutomationProperties.AutomationId="PrepareButton"/>
                </StackPanel>
                <TextBlock x:Name="PrepareNote" x:Uid="PrepareNote" TextWrapping="Wrap"
                           Style="{ThemeResource CaptionTextBlockStyle}"/>
                <ProgressBar x:Name="PrepareProgress" Maximum="100" Visibility="Collapsed"
                             AutomationProperties.AutomationId="PrepareProgress"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Spacing="8">
                <ComboBox x:Name="CategoryFilterBox" x:Uid="CategoryFilterBox" HorizontalAlignment="Stretch"
                          SelectionChanged="Filter_Changed" AutomationProperties.AutomationId="CategoryFilterBox"/>
                <TextBox x:Name="TagFilterBox" x:Uid="TagFilterBox"
                         TextChanged="Filter_Changed" AutomationProperties.AutomationId="TagFilterBox"/>
            </StackPanel>
            <ListView x:Name="MemoList" Grid.Row="3" SelectionChanged="MemoList_SelectionChanged"
                      AutomationProperties.AutomationId="MemoList">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:MemoItem">
                        <StackPanel Padding="4" Spacing="2">
                            <TextBlock Text="{x:Bind Title, Mode=OneTime}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                <Run Text="{x:Bind CategoryName, Mode=OneTime}"/>
                                <Run Text="  "/>
                                <Run Text="{x:Bind Tags, Mode=OneTime}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="4" Spacing="4">
                <HyperlinkButton x:Name="ModelFolderButton" x:Uid="ModelFolderButton" Click="OpenModelFolder_Click"
                                 AutomationProperties.AutomationId="ModelFolderButton"/>
                <HyperlinkButton x:Name="DataFolderButton" x:Uid="DataFolderButton" Click="OpenDataFolder_Click"
                                 AutomationProperties.AutomationId="DataFolderButton"/>
            </StackPanel>
        </Grid>

        <!-- 右の列：本文・AIの候補・状態表示 -->
        <Grid Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Spacing="3">
                <TextBlock x:Uid="MemoHeading" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <TextBlock x:Name="StatusLabel" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.AutomationId="StatusLabel"/>
                <TextBlock x:Name="ElapsedLabel" Style="{ThemeResource CaptionTextBlockStyle}"
                           AutomationProperties.AutomationId="ElapsedLabel"/>
            </StackPanel>
            <TextBox x:Name="BodyBox" x:Uid="BodyBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="BodyBox"/>
            <StackPanel Grid.Row="2" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RecordButton" Click="Record_Click" AutomationProperties.AutomationId="RecordButton"/>
                    <Button x:Name="SummarizeButton" x:Uid="SummarizeButton" Click="Summarize_Click"
                            AutomationProperties.AutomationId="SummarizeButton"/>
                    <Button x:Name="TagButton" x:Uid="TagButton" Click="Tag_Click"
                            AutomationProperties.AutomationId="TagButton"/>
                    <Button x:Name="SaveButton" x:Uid="SaveButton" Click="Save_Click"
                            Style="{ThemeResource AccentButtonStyle}"
                            AutomationProperties.AutomationId="SaveButton"/>
                </StackPanel>
                <!-- AIの準備前だけ表示する -->
                <TextBlock x:Name="AiButtonsNote" x:Uid="AiButtonsNote" TextWrapping="Wrap"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="AiButtonsNote"/>
            </StackPanel>
            <Grid Grid.Row="3" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SummaryBox" x:Uid="SummaryBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
                         AutomationProperties.AutomationId="SummaryBox"/>
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBox x:Name="TagsBox" x:Uid="TagsBox" AutomationProperties.AutomationId="TagsBox"/>
                    <ComboBox x:Name="CategoryBox" x:Uid="CategoryBox" HorizontalAlignment="Stretch"
                              AutomationProperties.AutomationId="CategoryBox"/>
                </StackPanel>
            </Grid>
            <InfoBar x:Uid="PrivacyInfo" Grid.Row="4" IsOpen="True" IsClosable="False" Severity="Informational"/>
        </Grid>
    </Grid>
</Window>
